 "lore": {
  "intro": "There is no deck like this on the station.\nYou are not on the station anymore.\n\nSixteen rooms. Every room borders four.\nBleed carefully. It's the only ink you have.",
  "radio": [
   {
    "trigger": "start",
    "text": "Ratio: Your beacon is sixteen places at once, all equally strong. I'll talk you through by TOPOLOGY, because geometry has resigned."
   },
   {
    "trigger": "enter_room:15",
    "text": "Ratio: THERE. Signal spike. The way down is in that room."
   },
   {
    "trigger": "enter_room:10",
    "text": "Ratio: The spike answers when you move. Four doors from home, Commando. Count in bits, not meters."
   },
   {
    "trigger": "pickup:void",
    "text": "Ratio: A token, waiting in 1010 \u2014 two bit-flips from the spike. You're learning to read this place. I'm not sure that's good."
   },
   {
    "trigger": "exit",
    "text": "Ratio: You crossed a four-dimensional cube on foot. When we get home I'm never telling anyone this, and neither are you."
   }
  ],
  "terminals": [
   {
    "room": 5,
    "pos": [
     539.3933982822018,
     539.3933982822018
    ],
    "text": "SCRATCHED IN THE FLOOR\n0 1 0 1\nif you can read this,\nflip one bit at a time.\n\u2014 O."
   },
   {
    "room": 7,
    "pos": [
     1339.3933982822018,
     539.3933982822018
    ],
    "text": "[TRANSLATION CONFIDENCE 41%]\nwelcome / student / stranger.\nthis room is a lesson.\nthe lesson: >>four<< is a direction.\ndo not fear the direction.\nwe feared it. fear did not help."
   },
   {
    "room": 2,
    "pos": [
     939.3933982822018,
     139.3933982822018
    ],
    "text": "[TRANSLATION CONFIDENCE 33%]\nsixteen is not the number of rooms.\nsixteen is how many names one room accepts\nbefore it stops answering to the first.\nwe did not choose one name each. the choosing\nwas the mistake the last generation made."
   },
   {
    "room": 10,
    "pos": [
     939.3933982822018,
     939.3933982822018
    ],
    "text": "[TRANSLATION CONFIDENCE 27%]\na token waits where a student will stand.\nthe aperture beneath the sixteenth name\nwill not part for an untaught hand.\ncarry the token. it remembers the walk\nfor you."
   },
   {
    "room": 11,
    "pos": [
     1339.3933982822018,
     939.3933982822018
    ],
    "text": "CARGO TAG, MIRIAD STOCK NUMBER \u2014 FOUND HERE,\nHALF BURIED\nContents: 2x fertilizer drum.\nThis tag belongs four levels back, in a\nstoreroom that grows food. There is no food\nhere. There was no floor here, on any schematic,\nbefore today.\nNobody has come to collect it."
   }
  ]
 },
