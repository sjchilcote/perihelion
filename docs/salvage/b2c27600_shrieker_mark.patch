+    def _alarm_tick(self, ppolygon: int) -> None:
+        """Deposit the intruder's passive SCENT, amplified while he wears a
+        MARK. The mark's follow-me TRAIL is laid where he actually crosses
+        portals (see the transfer handler in _consume_events); here it only
+        drives the scent output the existing swarm already climbs."""
+        tc = self.tick_count
+        # the mark decays on its own; only a fresh shrieker marker renews it
+        self.brand.decay(1.0 / BRAND_DURATION)
+        brand = self.brand.strength
+        loud = (tc - getattr(self, "last_fire_tick", -999)) < 45
+        # passive SCENT: presence deposits a decaying breadcrumb the swarm
+        # climbs even in silence; louder while firing; a carried structure hums;
+        # a MARK makes it pour (the glob).
+        scent = 0.55 if loud else 0.12
+        scent *= 1.0 + 0.85 * sum(self.CARRY_WEIGHT.get(k, 0.0)
+                                  for k in self.carried)
