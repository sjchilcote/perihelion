+# --- THE MARK / shrieker (director 2026-07-25) --------------------------------
+# The shrieker runs a self-contained hunt: WARNING (raise the group) ->
+# APPROACHING_TO_MARK (close the distance) -> MARKING (a 3x-speed dash to slip
+# off the intruder's firing line and fire a MARKER projectile) -> RALLYING
+# (spread the alarm), then stands down to SENTINEL. The marker is a real
+# projectile; on contact it sticks a glob to the intruder -- the MARK.
+#
+# While the MARK holds, it drives the EXISTING systems: it lays the army-ant
+# follow-me TRAIL where he crosses portals (counting as many hunter crossings,
+# so the swarm's chemotaxis traces his exact route) and it makes his SCENT pour.
+# The mark decays on its own; only a fresh marker renews it.
+BRAND_DURATION = 14 * TICK_RATE   # the mark fully fades in ~14s if not renewed
+BRAND_SCENT_GAIN = 8.0            # a marked intruder's scent pours (×(1+this))
+BRAND_TRAIL_DEPOSIT = 8.0         # follow-me trail laid on each crossed doorway
+                                  # while marked (= the edge's saturation cap,
+                                  # i.e. a whole worn lane in one crossing)
+MARK_SPEED_MULT = 3.0             # MARKING dash: this much faster than cruise
+MARK_FIRE_RANGE = 210.0           # fires the marker from within this range
+MARK_AIM_TICKS = 18              # holds to aim ~300ms once off his firing line
+MARKER_SPEED = 620.0             # the marker projectile's speed
+MARKER_TTL = 150                 # ...and how long it flies before fizzling
+RALLY_TICKS = 12 * TICK_RATE     # how long a shrieker spreads the alarm after
+# WARDEN ENGULF (director 2026-07-25): "that'll teach 'em to keep their
+# distance." A warden in range stops, flashes twice over ~200ms, then LUNGES at
+# 2.5x its cruise speed. The lunge state lasts until friction drops its speed
+# back below cruise. If it makes solid contact during the lunge -- a real head-on
+# hit, not a graze (velocity aligned with the bearing to the player) -- the
+# player is dragged into its core and takes rapid damage until he shoots it off.
+WARDEN_ENGULF_RANGE = 155.0    # start the charge when the player is this close
+WARDEN_ENGULF_CHARGE = 12      # ~200ms wind-up (flashes twice), fully exposed
+WARDEN_CRUISE_RATE = 130.0     # its ordinary move speed (px/s); lunge ends below
+WARDEN_ENGULF_LUNGE_MULT = 2.5 # lunge speed = cruise * this
+WARDEN_ENGULF_DOT = 0.5        # min alignment(velocity, bearing) to catch
+WARDEN_ENGULF_DPS = 75.0       # damage/second while the player is engulfed
+WARDEN_ENGULF_COOLDOWN = 5 * TICK_RATE   # the only escape is to KILL the warden
+
